# ---- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ----
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=paste_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=paste_sandbox_secret_here

# ---- AI provider: set ONE key (or leave both empty to use the offline fallback) ----
# LLM_PROVIDER=anthropic        # optional: anthropic | gemini | mock
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---- Safety rules (amounts in cents) ----
AUTO_LIMIT_CENTS=1500
APPROVAL_LIMIT_CENTS=10000
DAILY_BUDGET_CENTS=15000
MAX_ITEMS=10
ALWAYS_REVIEW_CATEGORIES=gift_cards
BLOCKED_CATEGORIES=gambling

# ---- ESP32 approval key (must match the Arduino sketch) ----
DEVICE_ID=payguard-esp32-01
DEVICE_SECRET=change-me-to-a-long-random-string
REQUIRE_HARDWARE=0

# ---- Server ----
PORT=5000
# BASE_URL=http://localhost:5000
